# Configuration de la base de données PostgreSQL
# Format: postgres://username:password@host:port/database?sslmode=disable
# Exemple local: postgres://postgres:password@localhost:5432/groupietracker?sslmode=disable
# Exemple Scalingo: postgres://user:pass@host.scalingo.com:5432/dbname?sslmode=prefer
DATABASE_URL=postgres://username:password@localhost:5432/groupietracker?sslmode=disable
